{
  "name": "application-tracker",
  "version": "0.5.0",
  "private": true,
  "productName": "Fieldwork",
  "description": "my job application tracker",
  "author": "alexvoneida",
  "main": ".desktop-build/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "worker": "tsx server/worker.ts",
    "worker:status": "tsx server/worker-status.ts",
    "telegram:setup": "tsx server/telegram-setup.ts",
    "desktop:build": "npm run build && node desktop/build.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && node desktop/package.mjs",
    "desktop:make": "npm run desktop:package && node desktop/make-dmg.mjs",
    "test:desktop": "npm run desktop:build && playwright test --config=playwright.desktop.config.ts",
    "test:packaged": "node desktop/test-packaged.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run test && npm run build",
    "format": "prettier --write src server shared desktop tests *.ts *.json index.html README.md"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "switchboard-ai-sdk": "0.1.9",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
