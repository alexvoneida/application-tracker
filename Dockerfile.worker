FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY shared ./shared
RUN mkdir -p /data && chown node:node /data
USER node
ENV NODE_ENV=production WORKER_DATA_DIR=/data DISCOVERY_CONFIG_FILE=/config/fieldwork-worker.json
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 CMD npm run worker:status
CMD ["npm", "run", "worker"]
